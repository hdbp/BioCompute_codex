{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nextflow FASTQ QC",
  "description": "Example of a real Nextflow DSL2 workflow, processing local FASTQ files.",
  "definitions": {
    "input_output_options": {
      "title": "Input and output",
      "properties": {
        "input": { "type": "string", "title": "Input CSV samplesheet", "format": "file-path", "description": "Automatically generated from the Experiment editor." },
        "outdir": { "type": "string", "title": "Output directory", "description": "Automatically assigned per run." }
      }
    },
    "quality_options": {
      "title": "Analysis parameters",
      "properties": {
        "min_length": { "type": "integer", "title": "Minimum read length warning threshold", "default": 20, "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
